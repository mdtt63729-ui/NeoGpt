#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#
# NOTE: gradle/wrapper/gradle-wrapper.jar is not committed in this source-only
# drop because it is a binary. Android Studio (or `gradle wrapper`) regenerates
# it on first sync. See README.md.
#

APP_HOME=$(cd -P -- "$(dirname -- "$0")" && pwd -P) || exit 1

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
    echo "gradle-wrapper.jar is missing." >&2
    echo "Open this project in Android Studio (it regenerates the wrapper), or run:" >&2
    echo "    gradle wrapper --gradle-version 8.9" >&2
    exit 1
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=gradlew" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
